# Copy this file to .env and fill in your values.
# Variables prefixed with VITE_ are exposed to the browser — never put secrets here.

# Application name shown in the page title
VITE_APP_NAME=RISSE

# Laravel API base URL.
# When using the Vite proxy (vite.config.js), you can use a relative path:
#   VITE_API_BASE_URL=/api
# For direct cross-origin requests, use the full URL:
#   VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_API_BASE_URL=http://127.0.0.1:8000/api
