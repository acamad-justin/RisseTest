# ==========================================
# Root .gitignore — RISSE Project
# ==========================================

# OS artifacts
.DS_Store
Thumbs.db
*.log

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# Frontend (frontend/)
# ==========================================
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# ==========================================
# Backend (backend/)
# ==========================================
backend/vendor/
backend/.env
backend/.env.backup
backend/storage/logs/*.log
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/testing/*
backend/storage/framework/views/*
backend/bootstrap/cache/config.php
backend/bootstrap/cache/packages.php
backend/bootstrap/cache/routes*.php
backend/bootstrap/cache/services.php
backend/database/database.sqlite

# ==========================================
# Node / npm
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
